{
  "name": "gsheet.action",
  "version": "0.0.0",
  "description": "A github action to help with CRUD operations on google sheets.",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "document": "tsc bin/* --types node --outDir lib && node ./lib/bin/documentation.js",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src bin --quiet --fix",
    "lint:check": "eslint src bin --quiet",
    "clean": "rm -rf dist && rm -rf lib",
    "package": "npm run build && ncc build --external bin --source-map --license licenses.txt",
    "test": "jest --coverage",
    "all": "npm run clean && npm run build && npm run format && npm run lint && npm run package && npm test",
    "test:watch": "jest --watch --coverage",
    "semantic-release": "semantic-release",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jroehl/gsheet.action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "jroehl <mail@johannroehl.de>",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "google-sheet-cli": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "js-yaml": "^4.1.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
